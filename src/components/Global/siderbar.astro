            </div>
            <button
                class="p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors shrink-0 cursor-pointer"
                title="Cerrar sesión"
                type="button"
            >
                <i class="ri-logout-box-r-line text-lg"></i>
            </button>
        </div>
    </div>
</aside>
