                >
                <span
                    class="px-1.5 py-0.5 text-[10px] font-semibold bg-indigo-500/15 text-indigo-400 border border-indigo-500/30 rounded-md"
                    >RRHH</span
                >
            </div>
            <span class="text-xs text-slate-400 font-medium truncate"
                >Control & Gestión</span
            >
        </div>
    </div>

    <!-- Menú Principal -->
    <nav
        class="flex-1 overflow-y-auto px-3.5 py-4 space-y-6 [scrollbar-width:thin] [scrollbar-color:#334155_transparent]"
